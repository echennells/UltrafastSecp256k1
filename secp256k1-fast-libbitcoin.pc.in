prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: secp256k1-fast-libbitcoin
Description: UltrafastSecp256k1 libbitcoin integration
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires: @SECP256K1_LIBBITCOIN_PC_REQUIRES@
Cflags: -I${includedir}
Libs: -L${libdir} @SECP256K1_LIBBITCOIN_PC_LIBS@
